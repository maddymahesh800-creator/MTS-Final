    {
      "name": "existsByTransactionId",
      "signature": "public abstract boolean com.fd.repository.RewardRepository.existsByTransactionId(java.lang.String)",
      "query": {
        "query": "SELECT r.id id FROM Rewards r WHERE r.transactionId = :transactionId"
      }
    },
    {
      "name": "findByAccountId",
      "signature": "public abstract java.util.List<com.fd.model.Rewards> com.fd.repository.RewardRepository.findByAccountId(java.lang.String)",
      "query": {
        "query": "SELECT r FROM Rewards r WHERE r.accountId = :accountId"
      }
    },
    {
      "name": "findByAccountIdAndIsActiveTrue",
      "signature": "public abstract java.util.List<com.fd.model.Rewards> com.fd.repository.RewardRepository.findByAccountIdAndIsActiveTrue(java.lang.String)",
      "query": {
        "query": "SELECT r FROM Rewards r WHERE r.accountId = :accountId AND r.isActive = TRUE"
      }
    },
    {
      "name": "findByAccountIdAndIsActiveTrueOrderByRewardCreatedAtDesc",
      "signature": "public abstract java.util.List<com.fd.model.Rewards> com.fd.repository.RewardRepository.findByAccountIdAndIsActiveTrueOrderByRewardCreatedAtDesc(java.lang.String)",
      "query": {
        "query": "SELECT r FROM Rewards r WHERE r.accountId = :accountId AND r.isActive = TRUE ORDER BY r.rewardCreatedAt desc"
      }
    },
    {
      "name": "findByTransactionId",
      "signature": "public abstract java.util.Optional<com.fd.model.Rewards> com.fd.repository.RewardRepository.findByTransactionId(java.lang.String)",
      "query": {
        "query": "SELECT r FROM Rewards r WHERE r.transactionId = :transactionId"
      }
    },
    {
      "name": "getTotalRewardsForUser",
      "signature": "public abstract java.lang.Long com.fd.repository.RewardRepository.getTotalRewardsForUser(java.lang.String)",
      "query": {
        "query": "SELECT COALESCE(SUM(r.points), 0) FROM Rewards r WHERE r.accountId = :accountId AND r.isActive = true"
      }
    },
